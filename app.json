{
  "expo": {
    "name": "Lunara",
    "slug": "lunara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lunara",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#38315C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ssssamriddhi.lunara"
    },
    "android": {
      "package": "com.ssssamriddhi.lunara",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#38315C"
      },
      "permissions": [],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FDF8FC",
      "translucent": false
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "3af5dd69-ebc3-40a7-a1d7-ed1a3e26b7d3"
      }
    }
  }
}